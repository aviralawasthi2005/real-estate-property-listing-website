# ==============================================================================
# Estate Application - Production Environment Configuration Template
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=3000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mern-estate?retryWrites=true&w=majority
MONGO=mongodb://127.0.0.1:27017/mern-estate

# JSON Web Token Secret Key (Use a strong, 64-char random string in production)
JWT_SECRET=super_secret_jwt_key_replace_with_crypto_random_in_production

# Google Gemini AI API Key (Optional: for real-time AI Property Assistant)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated for multiple domains)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Client Environment Variables (Prefixed with VITE_)
# ------------------------------------------------------------------------------
# VITE_BACKEND_URL=http://localhost:3000
# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
# VITE_FIREBASE_APP_ID=your_app_id
